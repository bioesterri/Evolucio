{
  "$defs": {
    "EnergyConfig": {
      "additionalProperties": false,
      "description": "Energy economy parameters; no runtime balance is implemented here.",
      "properties": {
        "initial_energy": {
          "title": "Initial Energy",
          "type": "number"
        },
        "max_energy": {
          "title": "Max Energy",
          "type": "number"
        },
        "death_threshold": {
          "minimum": 0,
          "title": "Death Threshold",
          "type": "number"
        },
        "basal_cost": {
          "minimum": 0,
          "title": "Basal Cost",
          "type": "number"
        },
        "movement_cost": {
          "minimum": 0,
          "title": "Movement Cost",
          "type": "number"
        },
        "feeding_cost": {
          "minimum": 0,
          "title": "Feeding Cost",
          "type": "number"
        },
        "feeding_conversion": {
          "exclusiveMinimum": 0,
          "title": "Feeding Conversion",
          "type": "number"
        },
        "reproduction_threshold": {
          "title": "Reproduction Threshold",
          "type": "number"
        },
        "reproduction_cost": {
          "minimum": 0,
          "title": "Reproduction Cost",
          "type": "number"
        },
        "offspring_initial_energy": {
          "title": "Offspring Initial Energy",
          "type": "number"
        },
        "failed_action_cost": {
          "minimum": 0,
          "title": "Failed Action Cost",
          "type": "number"
        }
      },
      "required": [
        "initial_energy",
        "max_energy",
        "death_threshold",
        "basal_cost",
        "movement_cost",
        "feeding_cost",
        "feeding_conversion",
        "reproduction_threshold",
        "reproduction_cost",
        "offspring_initial_energy",
        "failed_action_cost"
      ],
      "title": "EnergyConfig",
      "type": "object"
    },
    "EnvironmentPhaseConfig": {
      "additionalProperties": false,
      "description": "A deterministic environmental interval, with an exclusive end.",
      "properties": {
        "start_step": {
          "minimum": 0,
          "title": "Start Step",
          "type": "integer"
        },
        "end_step": {
          "exclusiveMinimum": 0,
          "title": "End Step",
          "type": "integer"
        },
        "regeneration_multiplier": {
          "minimum": 0,
          "title": "Regeneration Multiplier",
          "type": "number"
        },
        "stress_level": {
          "maximum": 1,
          "minimum": 0,
          "title": "Stress Level",
          "type": "number"
        }
      },
      "required": [
        "start_step",
        "end_step",
        "regeneration_multiplier",
        "stress_level"
      ],
      "title": "EnvironmentPhaseConfig",
      "type": "object"
    },
    "EvolutionConfig": {
      "additionalProperties": false,
      "description": "Age and heritable mutation parameters.",
      "properties": {
        "min_reproduction_age": {
          "minimum": 1,
          "title": "Min Reproduction Age",
          "type": "integer"
        },
        "max_age": {
          "exclusiveMinimum": 0,
          "title": "Max Age",
          "type": "integer"
        },
        "mutation_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mutation Rate",
          "type": "number"
        },
        "mutation_sigma": {
          "minimum": 0,
          "title": "Mutation Sigma",
          "type": "number"
        },
        "mutation_clip_abs": {
          "exclusiveMinimum": 0,
          "title": "Mutation Clip Abs",
          "type": "number"
        }
      },
      "required": [
        "min_reproduction_age",
        "max_age",
        "mutation_rate",
        "mutation_sigma",
        "mutation_clip_abs"
      ],
      "title": "EvolutionConfig",
      "type": "object"
    },
    "PersistenceConfig": {
      "additionalProperties": false,
      "description": "Host-only persistence intent.",
      "properties": {
        "level": {
          "default": "none",
          "enum": [
            "none",
            "minimal",
            "standard",
            "massive"
          ],
          "title": "Level",
          "type": "string"
        },
        "destinations": {
          "default": [],
          "items": {
            "enum": [
              "local",
              "postgresql",
              "mlflow"
            ],
            "type": "string"
          },
          "title": "Destinations",
          "type": "array"
        },
        "output_dir": {
          "default": "runs",
          "minLength": 1,
          "title": "Output Dir",
          "type": "string"
        },
        "batch_size": {
          "default": 1024,
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "checkpoint_stride": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Stride"
        }
      },
      "title": "PersistenceConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "description": "Versioned fixed-topology policy parameters.",
      "properties": {
        "observation_schema_version": {
          "const": "1.0",
          "title": "Observation Schema Version",
          "type": "string"
        },
        "action_schema_version": {
          "const": "1.0",
          "title": "Action Schema Version",
          "type": "string"
        },
        "hidden_size": {
          "const": 16,
          "title": "Hidden Size",
          "type": "integer"
        },
        "activation": {
          "const": "tanh",
          "title": "Activation",
          "type": "string"
        },
        "perception_radius": {
          "maximum": 3,
          "minimum": 1,
          "title": "Perception Radius",
          "type": "integer"
        }
      },
      "required": [
        "observation_schema_version",
        "action_schema_version",
        "hidden_size",
        "activation",
        "perception_radius"
      ],
      "title": "PolicyConfig",
      "type": "object"
    },
    "PopulationConfig": {
      "additionalProperties": false,
      "description": "Fixed-capacity population parameters.",
      "properties": {
        "initial_agents": {
          "exclusiveMinimum": 0,
          "title": "Initial Agents",
          "type": "integer"
        },
        "max_agents": {
          "exclusiveMinimum": 0,
          "title": "Max Agents",
          "type": "integer"
        },
        "max_births_per_step": {
          "exclusiveMinimum": 0,
          "title": "Max Births Per Step",
          "type": "integer"
        },
        "placement": {
          "const": "random",
          "title": "Placement",
          "type": "string"
        },
        "allow_multiple_agents_per_cell": {
          "title": "Allow Multiple Agents Per Cell",
          "type": "boolean"
        }
      },
      "required": [
        "initial_agents",
        "max_agents",
        "max_births_per_step",
        "placement",
        "allow_multiple_agents_per_cell"
      ],
      "title": "PopulationConfig",
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "description": "Host execution parameters.",
      "properties": {
        "steps": {
          "exclusiveMinimum": 0,
          "title": "Steps",
          "type": "integer"
        },
        "chunk_size": {
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "record_stride": {
          "exclusiveMinimum": 0,
          "title": "Record Stride",
          "type": "integer"
        },
        "snapshot_stride": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Stride"
        },
        "backend": {
          "enum": [
            "cpu",
            "auto"
          ],
          "title": "Backend",
          "type": "string"
        }
      },
      "required": [
        "steps",
        "chunk_size",
        "record_stride",
        "snapshot_stride",
        "backend"
      ],
      "title": "RuntimeConfig",
      "type": "object"
    },
    "WorldConfig": {
      "additionalProperties": false,
      "description": "Declarative two-dimensional world parameters.",
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "boundary_mode": {
          "const": "closed",
          "title": "Boundary Mode",
          "type": "string"
        },
        "resource_capacity": {
          "minimum": 0,
          "title": "Resource Capacity",
          "type": "number"
        },
        "initial_resource_mean": {
          "minimum": 0,
          "title": "Initial Resource Mean",
          "type": "number"
        },
        "resource_distribution": {
          "enum": [
            "uniform",
            "patches"
          ],
          "title": "Resource Distribution",
          "type": "string"
        },
        "resource_patch_count": {
          "exclusiveMinimum": 0,
          "title": "Resource Patch Count",
          "type": "integer"
        },
        "resource_patch_radius": {
          "exclusiveMinimum": 0,
          "title": "Resource Patch Radius",
          "type": "number"
        },
        "resource_patch_contrast": {
          "maximum": 1,
          "minimum": 0,
          "title": "Resource Patch Contrast",
          "type": "number"
        },
        "environment_initial_value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Environment Initial Value",
          "type": "number"
        },
        "regeneration_rate": {
          "minimum": 0,
          "title": "Regeneration Rate",
          "type": "number"
        },
        "environment_schedule": {
          "items": {
            "$ref": "#/$defs/EnvironmentPhaseConfig"
          },
          "title": "Environment Schedule",
          "type": "array"
        }
      },
      "required": [
        "width",
        "height",
        "boundary_mode",
        "resource_capacity",
        "initial_resource_mean",
        "resource_distribution",
        "resource_patch_count",
        "resource_patch_radius",
        "resource_patch_contrast",
        "environment_initial_value",
        "regeneration_rate",
        "environment_schedule"
      ],
      "title": "WorldConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete validated scientific configuration for schema 2.0.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "world": {
      "$ref": "#/$defs/WorldConfig"
    },
    "population": {
      "$ref": "#/$defs/PopulationConfig"
    },
    "policy": {
      "$ref": "#/$defs/PolicyConfig"
    },
    "energy": {
      "$ref": "#/$defs/EnergyConfig"
    },
    "evolution": {
      "$ref": "#/$defs/EvolutionConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "persistence": {
      "$ref": "#/$defs/PersistenceConfig"
    }
  },
  "required": [
    "schema_version",
    "seed",
    "world",
    "population",
    "policy",
    "energy",
    "evolution",
    "runtime"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
